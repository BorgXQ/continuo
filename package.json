{
  "name": "infiticum",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time Adaptive Music Looper",
  "author": "BorgXQ",
  "main": ".vite/build/index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "build": "npm run typecheck && electron-forge package",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
