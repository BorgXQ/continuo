    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  }
}
